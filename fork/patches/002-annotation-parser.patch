@@ -151,6 +154,16 @@ func Walk(n Node, f func(Node) bool) {
 		}
 		Walk(n.Body, f)
 
+	case *TypeExpr:
+		Walk(n.Expr, f)
+
+	case *TypedParam:
+		Walk(n.Name, f)
