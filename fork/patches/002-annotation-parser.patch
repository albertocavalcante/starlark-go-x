 func (p *parser) parseParams() []Expr {
 	var params []Expr
-	for p.tok != RPAREN && p.tok != COLON && p.tok != EOF {
+	for p.tok != RPAREN && p.tok != COLON && p.tok != ARROW && p.tok != EOF {
