+
+	// Parse optional return type annotation: -> type
+	var arrowPos Position
+	var returnType *TypeExpr
+	if p.tok == ARROW {
+		if p.options.Types == TypesDisabled {
+			p.in.errorf(p.tokval.pos, "got %#v, want ':'", p.tok)
+		}
+		arrowPos = p.nextToken() // consume ARROW
+		returnType = p.parseTypeExpr()
+	}
+
 	p.consume(COLON)
 	body := p.parseSuite()
 	return &DefStmt{
-		Def:    defpos,
-		Name:   id,
-		Lparen: lparen,
-		Params: params,
-		Rparen: rparen,
-		Body:   body,
+		Def:        defpos,
+		Name:       id,
+		Lparen:     lparen,
+		Params:     params,
+		Rparen:     rparen,
+		Arrow:      arrowPos,
+		ReturnType: returnType,
+		Body:       body,
 	}
 }
 
@@ -483,7 +497,7 @@ func (p *parser) consume(t Token) Position {
