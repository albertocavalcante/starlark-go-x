diff --git a/syntax/syntax.go b/syntax/syntax.go
index 57983b4b3f810a8afdca8950c2e00d61010cbc93..8082e60f48b899c058e2a91c21988600c46c2a27 100644
--- a/syntax/syntax.go
+++ b/syntax/syntax.go
@@ -121,12 +121,14 @@ func (x *AssignStmt) Span() (start, end Position) {
 // A DefStmt represents a function definition.
 type DefStmt struct {
 	commentsRef
-	Def    Position
-	Name   *Ident
-	Lparen Position
-	Params []Expr // param = ident | ident=expr | * | *ident | **ident
-	Rparen Position
